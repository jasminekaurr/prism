+                                }
+                                .padding(12)
+                                .background {
+                                    RoundedRectangle(cornerRadius: PrismRadius.md)
+                                        .stroke(rating == option ? PrismColors.lavender : PrismColors.glassStroke)
+                                }
+                            }
+                            .buttonStyle(.plain)
+                            .frame(minHeight: 44)
